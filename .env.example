# Copy to .env and fill in. Leave blank to use the free Codex CLI backend.
# Never commit .env.

# Force a backend: codex_cli | anthropic | openai (default: auto-detect from keys, else codex_cli)
PHAEDRUS_LLM_MODE=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional paths
PHAEDRUS_WEB_CAPTURES_DIR=
PHAEDRUS_OBSIDIAN_VAULT=
